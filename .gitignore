# ============================================================
# Project-specific: data, derivatives
# ============================================================
derivatives/

# ============================================================
# Results: ignore everything under results/ EXCEPT the key
# group-level figures that summarise the analysis.
# ============================================================
results/*
archived/results*

# Archived pre-25-vol-cut network-size figures (kept for side-by-side comparison
# on GitHub). Parent dirs must be re-included first since archived/results* above
# ignores the whole tree and git won't descend into an ignored directory.
!archived/results_pre25vol_2026-06-30/
archived/results_pre25vol_2026-06-30/*
!archived/results_pre25vol_2026-06-30/results_network_size/
archived/results_pre25vol_2026-06-30/results_network_size/*
!archived/results_pre25vol_2026-06-30/results_network_size/emotional_by_group.png
!archived/results_pre25vol_2026-06-30/results_network_size/emotional_vs_salience.png
!archived/results_pre25vol_2026-06-30/results_network_size/group_networksize_DLD.png
!archived/results_pre25vol_2026-06-30/results_network_size/group_networksize_TD.png
!archived/results_pre25vol_2026-06-30/results_network_size/emotional_vs_salience_nb.png

# Top-level findings summary
results/FINDINGS_summary.md

# Group-level network-size figures + stats, both MS-HBM variants (full / icafix).
# Whitelist all figures + the 3-group stats CSVs; per-subject CSVs, the long
# table and the run transcript stay ignored.
!results/network_size_full/
results/network_size_full/*
!results/network_size_full/*.png
!results/network_size_full/group_stats_3group.csv
!results/network_size_full/group_posthoc_3group.csv

!results/network_size_icafix/
results/network_size_icafix/*
!results/network_size_icafix/*.png
!results/network_size_icafix/group_stats_3group.csv
!results/network_size_icafix/group_posthoc_3group.csv

# Group-level connectivity figures + stats (per-subject sub-*/ figures stay ignored,
# since git won't descend into the un-re-included sub-* dirs).
!results/connectivity_outputs/
results/connectivity_outputs/*
!results/connectivity_outputs/*.png
!results/connectivity_outputs/group_frontostriatal_omnibus.csv
!results/connectivity_outputs/group_frontostriatal_posthoc.csv
!results/connectivity_outputs/connectivity_emotional_nb_stats.csv

# Group-level language-connectivity figures + CSVs (per-subject sub-*/ stay ignored,
# since git won't descend into the un-re-included sub-* dirs). The dir itself must be
# re-included first, else results/* above ignores it and the negations never apply.
!results/language_connectivity_outputs/
results/language_connectivity_outputs/*
!results/language_connectivity_outputs/*.png
!results/language_connectivity_outputs/*.csv

# Single-subject figures (keep all PNG/JPG, ignore the rest)
!results/sub-509BT/
results/sub-509BT/*
!results/sub-509BT/*.png
!results/sub-509BT/*.jpg

# Python virtual environment
.venv/
